# FabriSee configuration (development defaults).
# `make setup` copies this file to .env and generates a SECRET_KEY. Never commit .env.

DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-generated-by-make-setup
DEBUG=1

# SQLite file by default. A PostgreSQL URL switches the database, for example
# postgres://user:password@host:5432/fabrisee
DATABASE_URL=sqlite:///backend/data/fabrisee.sqlite3

# Comma-separated. `.app.github.dev` is the domain of GitHub Codespaces.
ALLOWED_HOSTS=localhost,127.0.0.1,.app.github.dev
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.app.github.dev

# Base URL of the React app, used for links in emails.
FRONTEND_URL=http://localhost:5173

# Email: the development backend stores every message in the email log (Email outbox)
# and prints it to the console. In production use
# django.core.mail.backends.smtp.EmailBackend and fill in the EMAIL_* values.
EMAIL_BACKEND=apps.notifications.backends.DatabaseEmailBackend
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
DEFAULT_FROM_EMAIL=FabriSee <no-reply@fabrisee.local>

# Minutes between reminder checks of `manage.py run_scheduler` (PR6).
REMINDER_CHECK_MINUTES=5

# Allows `manage.py seed_demo` and `reset_demo`. Must be 0 in production.
ALLOW_DEMO_SEED=1

TIME_ZONE=Asia/Manila
