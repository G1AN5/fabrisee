// GitHub Codespaces / VS Code Dev Containers: opens FabriSee ready to use.
// The codespace installs everything and loads the demo data (make setup), then starts
// the app in a terminal (make dev) so the servers keep running and their logs stay visible.
{
  "name": "FabriSee",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "postCreateCommand": "make setup",
  "postAttachCommand": "make dev",
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": {
      "label": "FabriSee",
      "onAutoForward": "openBrowser"
    },
    "8000": {
      "label": "Django API",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/backend/.venv/bin/python",
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[typescriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[css]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "files.associations": {
          "*.css": "tailwindcss"
        }
      }
    }
  }
}
